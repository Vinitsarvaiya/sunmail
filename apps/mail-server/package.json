{
  "name": "@sunmail/mail-server",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts src/pipe.ts src/server.ts --format cjs,esm --dts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "server": "tsx src/server.ts",
    "pipe": "tsx src/pipe.ts"
  },
  "dependencies": {
    "@sunmail/shared": "workspace:*",
    "@supabase/supabase-js": "^2.43.4",
    "dotenv": "^16.4.5",
    "mailparser": "^3.7.1",
    "nodemailer": "^6.9.13",
    "smtp-server": "^3.13.3"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.4",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^6.4.15",
    "@types/smtp-server": "^3.5.10",
    "tsup": "^8.0.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
