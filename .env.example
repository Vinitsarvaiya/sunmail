# SunMail Environment Variables

# --- Frontend & Edge (Public + Client) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- VPS / Mail Processor & Secure Backend (Never expose to client!) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 32-byte hex encryption key for SMTP destination passwords (generate with: openssl rand -hex 32)
SMTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Mail Server Hostname & Inbound Settings
MAIL_DOMAIN=sunmail.com
MAIL_HOST=mail.sunmail.com
SMTP_PORT=2525
SMTP_LISTEN_HOST=0.0.0.0

# Optional: Max Message Size (bytes, default 25MB)
MAX_MESSAGE_SIZE=26214400
